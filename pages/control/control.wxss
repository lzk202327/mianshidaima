/* pages/control/control.wxss */
.box { padding: 30rpx; }
.title { font-size: 38rpx; font-weight: bold; margin-bottom: 30rpx; }
.inp, .picker {
  border: 1px solid #ccc;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
}
.picker { color: #333; background: #fafafa; }
.btn { background: #4CAF50; color: #fff; margin-bottom: 20rpx; }
.test { background: #ff9800; }
.back { background: #2196F3; }
.item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1px solid #eee;
}
.del { color: #f44336; }
.count { margin-top: 20rpx; color: #999; }