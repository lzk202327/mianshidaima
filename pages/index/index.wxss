.container {  
  background-color: #f0f5ff;  
  padding: 20px 10px;
  }
 .title{
  display:block;
font-size:18px;
margin-bottom: 20px;
}
.btn-box{
  white-space:nowrap;
  overflow-x:auto;
}  
.btn {  
  border: 4px solid #0055aa;  
  display: inline-block;  
  padding: 8px 10px;  
  margin-right: 8px;
  font-size:14px;
  }
  .home-wrap {
    min-height: 100vh;
    background: #f2f9f2;
    padding: 80rpx 40rpx;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .hero-title {
    font-size: 44rpx;
    font-weight: bold;
    color: #2e7d32;
    margin-bottom: 16rpx;
  }
  
  .hero-sub {
    font-size: 28rpx;
    color: #66aa66;
    margin-bottom: 80rpx;
  }
  
  /* 清默认双线边框 */
  .home-btn::after {
    border: 0;
  }
  
  /* 基础：大按钮 + 清晰轮廓 */
  .home-btn {
    width: 100%;
    margin-bottom: 32rpx;
    padding: 30rpx 0;
    font-size: 34rpx;
    font-weight: bold;
    border-radius: 28rpx;
    background: #fff;
    border: 3rpx solid #2e7d32;
    box-shadow: 0 6rpx 16rpx rgba(46, 125, 50, 0.18);
    letter-spacing: 2rpx;
  }
  
  /* 主按钮：深绿填色 */
  .btn-main {
    background: #2e7d32;
    color: #fff;
    border-color: #2e7d32;
  }
  
  /* 测试震动：橙边高亮 */
  .btn-demo {
    background: #fffdf8;
    color: #ef6c00;
    border-color: #ef6c00;
  }
  
  /* 返回/次级：白底绿字 */
  .btn-ghost {
    background: #fff;
    color: #2e7d32;
    border-color: #2e7d32;
  }
  
  .home-btn:active {
    transform: scale(0.97);
    opacity: 0.9;
  }